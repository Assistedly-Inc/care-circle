{
  "name": "carecircle-backend",
  "version": "0.1.0",
  "description": "CareCircle MVP backend – HIPAA/GDPR‑ready Cloudflare Worker",
  "main": "dist/server.js",
  
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "publish": "wrangler publish",
    "docker:build": "docker build -t carecircle-backend .",
    "docker:run": "docker compose up"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "argon2": "^0.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pdfmake": "^0.2.9",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pdfmake": "^0.3.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
